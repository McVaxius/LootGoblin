<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>0.3.4.8</Version>
    <FileVersion>0.3.4.8</FileVersion>
    <AssemblyVersion>0.3.4.8</AssemblyVersion>
    <PackageProjectUrl>https://github.com/McVaxius/LootGoblin</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <DalamudLibPath Condition="$(DALAMUD_HOME) != ''">$(DALAMUD_HOME)/</DalamudLibPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ECommons" Version="3.2.0.17" />
    <PackageReference Include="PInvoke.User32" Version="0.7.78" />
  </ItemGroup>

  <ItemGroup>
    <None Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="SpecialNavigation.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyPluginArtifacts" AfterTargets="Build">
    <PropertyGroup>
      <PluginOutput>$(OutputPath)$(AssemblyName)</PluginOutput>
    </PropertyGroup>

    <MakeDir Directories="$(PluginOutput)" />

    <ItemGroup>
      <PluginFiles Include="$(TargetPath)" />
      <PluginFiles Include="$(ProjectDir)$(AssemblyName).json" />
      <PluginFiles Include="$(ProjectDir)SpecialNavigation.json" />
    </ItemGroup>

    <ItemGroup>
      <DalamudPackagerFile Include="images\icon.png" />
    </ItemGroup>

    <Copy SourceFiles="@(PluginFiles)"
          DestinationFolder="$(PluginOutput)" />
  </Target>
</Project>
